# ---------------------------------------------------------------------------
# Gemini OCR Web Application - Production Environment Variables
# ---------------------------------------------------------------------------

# Google Gemini API Key(s) (Required)
# You can add a single key or multiple comma-separated keys for automatic load balancing & failover:
# GEMINI_API_KEY=key_1,key_2,key_3
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Vision Model (Default: gemini-3.6-flash)
OCR_MODEL=gemini-3.6-flash

# CORS Allowed Origins (comma-separated). Use your production domain in deployment.
# Example: https://scanline-ocr.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Maximum file size allowed in MB (Default: 10)
MAX_FILE_SIZE_MB=10

# API Request Timeout in seconds (Default: 30)
REQUEST_TIMEOUT_SECONDS=30

# Web server port (Default: 8000)
PORT=8000
